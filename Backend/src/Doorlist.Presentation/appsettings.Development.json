{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      
      "System.Net.Http.HttpClient.keycloak_admin_api.LogicalHandler": "Trace",
      "System.Net.Http.HttpClient.keycloak_admin_api.ClientHandler": "Trace"
    },
    "Console": {
      "FormatterName": "Json",
      "FormatterOptions": {
        "SingleLine": false,
        "TimestampFormat": "HH:mm:ss ",
        "JsonWriterOptions": {
          "Indented": true
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001",
        "Certificate": {
          "Path": "src/Doorlist.Infrastructure/Res/certs/doorlist.api.dev.pfx"
        }
      }
    }
  },
  "OpenSSL": {
    "ConfigPath": "src/Doorlist.Infrastructure/Res/openssl/openssl.pqc.cnf"
  },
  "Keycloak": {
    "AuthServerUrl": "https://localhost:8443",
    "Realm": "doorlist",
    "VerifySsl": "false",
    "Resource": "doorlist-api",
    "credentials": {}
  },
  "Databases": {
    "DoorlistAPI": {
      "Host": "localhost",
      "Port": 5434,
      "Database": "doorlist_app"
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  }
}
